  "wnBody1": {
    "message": "Kiko היה חינם כל הזמן שהוא אצלך. להחזיק אותו — שש שפות היום, ועוד בדרך — זו עבודה אמיתית, ולכן מהגרסה הזאת הוא עולה כסף."
  },
  "wnBody2": {
    "message": "התקנת לפני שהיה מחיר, ולכן אתה מקבל 60 יום ולא 30 כמו משתמש חדש. כל הזמן הזה הכול ממשיך לעבוד בדיוק כמו עכשיו."
  },
