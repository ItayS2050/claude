{
  "manifest_version": 3,
  "name": "KeyLang – Keyboard Language Detector",
  "version": "1.9.0",
  "description": "Alerts you when typing Hebrew in English mode (or vice versa). Learns from your feedback.",
  "permissions": ["storage"],
  "action": {
    "popup": "popup.html",
    "default_title": "KeyLang – Stats & Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
