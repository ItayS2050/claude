{
  "manifest_version": 3,
  "name": "Kiko – Hebrew ↔ English Layout Fixer",
  "version": "3.3.29",
  "description": "Kiko watches your typing and instantly catches when you're in the wrong keyboard layout — Hebrew or English. One click fixes it.",
  "author": "Kiko",
  "homepage_url": "https://kiko.app",
  "permissions": ["storage", "contextMenus", "offscreen"],
  "host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open Kiko popup"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "popup": "popup.html",
    "default_title": "Kiko – Hebrew ↔ English",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
