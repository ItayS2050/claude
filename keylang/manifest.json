{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "4.6.2",
  "description": "__MSG_extDescription__",
  "author": "Kiko",
  "homepage_url": "https://get-kiko.com",
  "permissions": ["storage", "contextMenus", "offscreen", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open Kiko popup"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "popup": "popup.html",
    "default_title": "Kiko – Hebrew, Russian & Arabic ↔ English",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
