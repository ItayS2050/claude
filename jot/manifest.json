{
  "manifest_version": 3,
  "name": "Jot – Quick Tasks & Voice Reminders",
  "version": "1.0.0",
  "description": "Capture a task by typing or talking, in one click. Jot reads \"tomorrow at 5\" as a real reminder and keeps the list tidy.",
  "permissions": ["storage", "alarms", "notifications", "contextMenus", "audioCapture"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jot – Quick Tasks (Alt+Shift+T)",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open Jot"
    }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
